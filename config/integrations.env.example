# PLACEHOLDERS ONLY. Configure privately in the deployment environment.
# Never expose these as VITE_ variables or commit a populated copy.
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-secret
SMTP_FROM=DigiQ Doctors <no-reply@example.invalid>
# Optional: defaults to true on port 465, false otherwise.
# SMTP_SECURE=false
# Optional: STARTTLS is mandatory when not using implicit TLS.
# SMTP_REQUIRE_TLS=true
OTP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=replace-with-account-sid
TWILIO_MESSAGING_SERVICE_SID=replace-with-messaging-service-sid
# Twilio credentials remain in the existing server-side connector.
# Choose one mode; native is the default for existing-cookie continuity.
# JWT: configure a dedicated high-entropy key >=32 UTF-8 bytes BEFORE enabling jwt.
# Both modes: fixed 12-hour database-revocable secure cookies, no refresh endpoint.
# Switching modes invalidates existing cookies.
AUTH_SESSION_MODE=native
# Leave blank until a dedicated random signing key is supplied privately.
JWT_SIGNING_KEY=