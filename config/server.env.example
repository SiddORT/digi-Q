# PLACEHOLDERS ONLY. Copy privately to /etc/digiq/server.env on your own server.
# Node.js 22+ supports --env-file. Never serve, commit or upload the populated file.
NODE_ENV=production
PORT=3000
DATABASE_URL=
SESSION_SECRET=
CLINICFLOW_PUBLIC_ORIGIN=https://your-domain.example
AUTH_SESSION_MODE=native
# First deployment only: configure all three privately to provision the initial admin.
# Startup reruns the seed safely; existing credentials are never overwritten.
# Leave these commented out when an administrator already exists.
# SUPERADMIN_EMAIL=
# SUPERADMIN_NAME=
# SUPERADMIN_PASSWORD=
# Bootstrap password: at least 12 characters, including letters and numbers.
# PREVIEW_SUPERADMIN_RECOVERY_PASSWORD is not used for deployment bootstrap.
# Only required if explicitly selecting jwt. Do not change an existing auth mode.
JWT_SIGNING_KEY=
# Exactly 64 hex characters from 32 cryptographically random bytes.
# Keep a secure backup: losing/changing this key makes saved credentials unreadable.
INTEGRATIONS_ENCRYPTION_KEY=
# Optional environment fallback: use config/integrations.env.example for the keys.
# Logo uploads: object (default, Replit App Storage) or local (persistent server disk).
# Never use local mode on ephemeral hosting such as Replit Autoscale.
MEDIA_STORAGE=object
# Local mode requires an absolute writable folder, outside the application/public tree.
# MEDIA_ROOT=/var/lib/digiq/uploads
# Public URL path served by the app, not a filesystem path or a shared-folder link.
MEDIA_URL=/media