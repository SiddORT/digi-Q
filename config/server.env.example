# PLACEHOLDERS ONLY. Copy privately to /etc/digiq/server.env on your own server.
# Node.js 22+ supports --env-file. Never serve, commit or upload the populated file.
NODE_ENV=production
PORT=3000
DATABASE_URL=
SESSION_SECRET=
CLINICFLOW_PUBLIC_ORIGIN=https://your-domain.example
AUTH_SESSION_MODE=native
# Only required if explicitly selecting jwt. Do not change an existing auth mode.
JWT_SIGNING_KEY=
# Exactly 64 hex characters from 32 cryptographically random bytes.
# Keep a secure backup: losing/changing this key makes saved credentials unreadable.
INTEGRATIONS_ENCRYPTION_KEY=
# Optional environment fallback: use config/integrations.env.example for the keys.