# PLACEHOLDERS ONLY. Copy privately to /etc/digiq/server.env on your own server.
# Node.js 22+ supports --env-file. Never serve, commit or upload the populated file.
NODE_ENV=production
PORT=3000
DATABASE_URL=
SESSION_SECRET=
# Single canonical HTTPS authority for all newly generated public/security links.
# No application path, credentials, query or fragment. Root hosting only.
# Restart the server and reload open browser tabs after changing this value.
CLINICFLOW_PUBLIC_ORIGIN=
AUTH_SESSION_MODE=native
# First deployment only: configure all three privately to provision the initial admin.
# Startup reruns the seed safely; existing credentials are never overwritten.
# Leave these commented out when an administrator already exists.
# SUPERADMIN_EMAIL=
# SUPERADMIN_NAME=
# SUPERADMIN_PASSWORD=
# Bootstrap password: at least 12 characters, including letters and numbers.
# PREVIEW_SUPERADMIN_RECOVERY_PASSWORD is not used for deployment bootstrap.
# Only required if explicitly selecting jwt. Do not change an existing auth mode.
JWT_SIGNING_KEY=
# Exactly 64 hex characters from 32 cryptographically random bytes.
# Keep a secure backup: losing/changing this key makes saved credentials unreadable.
INTEGRATIONS_ENCRYPTION_KEY=
# Optional environment fallback: use config/integrations.env.example for the keys.
# Media driver for NEW uploads: object (default) or local (persistent server disk).
# Existing files keep their recorded driver and locator; no automatic migration.
# Never use local mode on ephemeral hosting such as Replit Autoscale.
MEDIA_STORAGE=object
# Local mode requires an absolute writable folder, outside the application/public tree.
MEDIA_ROOT=
# Example local root: /var/lib/digiq/uploads. Private files require an uploads basename.
# Public URL path served by the app, not a filesystem path or a shared-folder link.
MEDIA_URL=/media
# Object driver only; retain these when historical object files still exist.
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=
# New private files are quarantined. An authorized Superadmin must attest an
# offline security review of the exact digest before attachment downloads.
# There is no automatic purge or retention duration.
# Private attachments only; blank inherits MEDIA_STORAGE (local/object).
# Select s3 deliberately only after reading docs/s3-private-storage.md.
# MEDIA_STORAGE and MEDIA_URL keep their separate public-logo contract.
FILES_STORAGE=
FILES_S3_BUCKET=
FILES_S3_REGION=
# Optional HTTPS origin only, no credentials/path/query/fragment; blank uses AWS.
FILES_S3_ENDPOINT=
FILES_S3_UPLOADS_PREFIX=
# Required for S3: literal true or false.
FILES_S3_FORCE_PATH_STYLE=
# Required for S3: role (SDK private credential chain) or static (secrets below).
FILES_S3_CREDENTIALS=
FILES_S3_ACCESS_KEY_ID=
FILES_S3_SECRET_ACCESS_KEY=
FILES_S3_SESSION_TOKEN=