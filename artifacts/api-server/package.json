{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:auth": "node --test ./src/native-auth.integration.test.mjs ./src/auth-http.integration.test.mjs ./src/jwt-session.test.mjs",
    "test:jwt": "node --test ./src/jwt-session.test.mjs",
    "test:staff-invitations": "node --test ./src/staff-invitation.integration.test.mjs",
    "test:booking-lookup-privacy": "node --test ./src/booking-lookup-privacy.integration.test.mjs",
    "test:queue-contention": "node --test ./src/queue-contention.test.mjs",
    "test:schedules": "node --test ./src/schedule-contention.test.mjs",
    "test:features": "node --test ./src/feature-policy.test.mjs ./src/functional-features.integration.test.mjs"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.2.0",
    "@replit/connectors-sdk": "^0.4.3",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "country-state-city": "^3.2.1",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "jspdf": "^4.2.1",
    "libphonenumber-js": "^1.13.14",
    "nodemailer": "^10.0.11",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
