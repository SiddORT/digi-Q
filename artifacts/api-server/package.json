{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && if [ -f ../../.local/owner-booking-browser-fixture ]; then node src/test-support/owner-booking-browser.mjs; elif [ -f ../../.local/staff-removal-browser-fixture ] || [ -f ../../.local/clinic-workspace-browser-fixture ]; then node src/test-support/staff-removal-browser.mjs; else pnpm run build && pnpm run start; fi",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:auth": "node --test ./src/native-auth.integration.test.mjs ./src/auth-http.integration.test.mjs ./src/jwt-session.test.mjs",
    "test:staff-removal": "node --test --test-concurrency=2 ./src/staff-*.integration.test.mjs ./src/staff-removal-review.test.mjs ./src/retired-staff*.integration.test.mjs ./src/development-deletion-guards.integration.test.mjs ./src/notification-history-provenance.integration.test.mjs ./src/exclusive-media-cleanup.integration.test.mjs",
    "test:jwt": "node --test ./src/jwt-session.test.mjs",
    "test:public-metadata": "node --test ./src/public-page-metadata.integration.test.mjs",
    "test:staff-invitations": "node --test ./src/staff-invitation.integration.test.mjs",
    "test:staff-accounts": "node --test --test-concurrency=1 ./src/staff-accounts.integration.test.mjs ./src/staff-invitation.integration.test.mjs ./src/users-administration.integration.test.mjs ./src/registration-onboarding.integration.test.mjs",
    "test:booking-lookup-privacy": "node --test ./src/booking-lookup-privacy.integration.test.mjs",
    "test:owner-booking": "node --test ./src/owner-booking.integration.test.mjs",
    "test:owner-booking:jwt": "node --test --test-name-pattern=jwt ./src/owner-booking.integration.test.mjs",
    "test:queue-contention": "node --test ./src/queue-contention.test.mjs",
    "test:schedules": "node --test --test-concurrency=1 ./src/schedule-contention.test.mjs ./src/schedule-day-overrides.test.mjs",
    "test:features": "node --test ./src/feature-policy.test.mjs ./src/functional-features.integration.test.mjs"
  },
  "dependencies": {
    "@workspace/public-pages": "workspace:*",
    "@google-cloud/storage": "^8.2.0",
    "@replit/connectors-sdk": "^0.4.3",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "country-state-city": "^3.2.1",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "jspdf": "^4.2.1",
    "libphonenumber-js": "^1.13.14",
    "nodemailer": "^10.0.11",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
