modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "queue-contention"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "ticket-browser-regression"

[[workflows.workflow]]
name = "queue-contention"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server test:queue-contention"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "ticket-browser-regression"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm test:tickets"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.development]
OTP_PROVIDER = "development"

[nix]
channel = "stable-25_05"
