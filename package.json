{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build:selfhost": "pnpm run typecheck && PORT=3000 BASE_PATH=/ pnpm --filter @workspace/clinicflow run build && pnpm --filter @workspace/api-server run build",
    "start:selfhost": "node --env-file=.env lib/db/seed.mjs && exec node --env-file=.env --enable-source-maps artifacts/api-server/dist/index.mjs",
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test:frontend": "pnpm --filter @workspace/scripts run test:frontend",
    "test:appointment-detail-compatibility": "node --test artifacts/api-server/src/test-support/postgres-tools.test.mjs && node scripts/test-appointment-detail-compatibility.mjs",
    "test:migrations": "node --test artifacts/api-server/src/test-support/postgres-tools.test.mjs && node scripts/test-postgres-migrations.mjs",
    "test:tickets": "playwright test --config artifacts/clinicflow/ticket-regression/playwright.config.ts",
    "test:live-tickets": "node --test --test-concurrency=1 artifacts/api-server/src/test-support/postgres-tools.test.mjs scripts/postgres-version-matrix.test.mjs artifacts/api-server/src/arrival-estimate.test.mjs && node scripts/test-live-ticket-compatibility.mjs",
    "test:clinic-metadata": "node --test --test-concurrency=1 artifacts/api-server/src/clinic-metadata.integration.test.mjs artifacts/api-server/src/registration-onboarding.integration.test.mjs artifacts/clinicflow/src/components/clinic-metadata.test.mjs artifacts/clinicflow/src/components/clinic-navigation.test.mjs artifacts/clinicflow/src/components/scope-completion.test.mjs",
    "test:communication-usage": "node --test --test-concurrency=1 artifacts/api-server/src/communication-usage.integration.test.mjs artifacts/api-server/src/notification-history-provenance.integration.test.mjs artifacts/api-server/src/notification-history-reconciliation.integration.test.mjs artifacts/api-server/src/notification-settings.integration.test.mjs artifacts/clinicflow/src/components/communication-usage.test.mjs artifacts/clinicflow/src/components/notification-logs.test.mjs"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@electric-sql/pglite": "^0.5.8",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "core-js"
    ]
  }
}
